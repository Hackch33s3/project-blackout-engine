ENGINE_API_KEY=your-secret-api-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ENGINE_URL=http://localhost:8000

# --- Proxy chain for target discovery (scanner.py reads these) ---
# Primary: Decodo residential, US exit (US brokers geo-block non-US IPs).
# Convert the Decodo gateway creds to US-geo form:
#   <user>:<pass>@gate.decodo.com:10001  ->  user-<user>-country-us:<pass>@gate.decodo.com:10001
DECODO_PROXY=http://user-spbhxsehqg-country-us:YOUR_DECODO_PASS@gate.decodo.com:10001
# Fallback: BrightData ISP (US). scanner.py falls through to this on DDG failure.
BRIGHTDATA_PROXY=http://brd-customer-hl_76ffc6f9-zone-worker1:YOUR_BRIGHTDATA_PASS@brd.superproxy.io:33335
